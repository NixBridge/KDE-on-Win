diff --git a/src/declarativeimports/plasmaextracomponents/qmenu.cpp b/src/declarativeimports/plasmaextracomponents/qmenu.cpp
index fe8f8e5..4be7705 100644
--- a/src/declarativeimports/plasmaextracomponents/qmenu.cpp
+++ b/src/declarativeimports/plasmaextracomponents/qmenu.cpp
@@ -31,7 +31,13 @@ QMenuProxy::QMenuProxy(QObject *parent)
         // Breeze and Oxygen have rounded corners on menus. They set this attribute in polish()
         // but at that time the underlying surface has already been created where setting this
         // flag makes no difference anymore (Bug 385311)
+        #ifdef Q_OS_WIN
+        m_menu->setAttribute(Qt::WA_TranslucentBackground, false);
+        m_menu->setAutoFillBackground(true);
+        m_menu->setWindowFlag(Qt::WindowStaysOnTopHint, true);
+#else
         m_menu->setAttribute(Qt::WA_TranslucentBackground);
+#endif
 
         KAcceleratorManager::manage(m_menu);
         connect(m_menu, &QMenu::triggered, this, &QMenuProxy::itemTriggered);
