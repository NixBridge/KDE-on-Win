+// Archive paths are portable bytes, not Windows local filesystem names.
+// Prefer valid UTF-8; retain the native-codepage fallback for old archives.
+static QString decodeTarName(const QByteArray &name)
+{
+#ifdef Q_OS_WIN
+    if (name.isValidUtf8()) return QString::fromUtf8(name);
+#endif
+    return QFile::decodeName(name);
+}
