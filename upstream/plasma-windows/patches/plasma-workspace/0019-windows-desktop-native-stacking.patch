+#ifdef Q_OS_WIN
+bool DesktopView::nativeEvent(const QByteArray &eventType, void *message, qintptr *result)
+{
+    // Constrain the actual native request before Windows changes the Z order.
+    // A queued lower() after activation leaves a fullscreen occluding desktop.
+    const auto msg = static_cast<MSG *>(message);
+    if (constrainWindowsDesktopStacking(msg->message, msg->lParam, result)) {
+        return true;
+    }
+    return PlasmaQuick::ContainmentView::nativeEvent(eventType, message, result);
+}
