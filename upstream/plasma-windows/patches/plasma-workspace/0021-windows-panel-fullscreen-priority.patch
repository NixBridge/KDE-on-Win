diff --git a/shell/windowsfullscreenpolicy.h b/shell/windowsfullscreenpolicy.h
new file mode 100644
--- /dev/null
+++ b/shell/windowsfullscreenpolicy.h
@@ -0,0 +1,9 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <windows.h>
+inline bool windowsCoversMonitor(const RECT& window,const RECT& monitor,bool ordinaryMaximized)
+{
+    return !ordinaryMaximized && monitor.right>monitor.left && monitor.bottom>monitor.top
+        && window.left<=monitor.left && window.top<=monitor.top
+        && window.right>=monitor.right && window.bottom>=monitor.bottom;
+}
