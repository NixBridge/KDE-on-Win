 #include <KIconLoader>
 #include <QFileInfo>
 #include <QIcon>
+#include <QHash>
+#include <QGuiApplication>
 
 namespace TaskManager {
 struct WindowsDesktopApp { const char *exe; const char *desktop; const char *icon; };
 inline constexpr WindowsDesktopApp windowsDesktopApps[] = {
+    {"plasma-archive-manager.exe", "org.nixbridge.archive.desktop", "utilities-file-archiver"},
     {"konsole.exe", "org.kde.konsole.desktop", "utilities-terminal"},
     {"dolphin.exe", "org.kde.dolphin.desktop", "system-file-manager"},
     {"plasma-process-monitor.exe", "org.nixbridge.processmonitor.desktop", "utilities-system-monitor"},
@@ -26,11 +29,20 @@ inline QIcon windowsRasterThemeIcon(const QString &name)
 {
     // On Windows a non-null theme engine may still produce no pixmap.
     // Use KDE's resource-aware loader and keep raster sizes for task delegates.
+    static QHash<QString,QIcon> cache;
+    static const bool connected=[] {
+        QObject::connect(KIconLoader::global(),&KIconLoader::iconChanged,KIconLoader::global(),[] {cache.clear();});
+        if(qGuiApp)QObject::connect(qGuiApp,&QGuiApplication::paletteChanged,KIconLoader::global(),[] {cache.clear();});
+        return true;
+    }();
+    Q_UNUSED(connected)
+    if(cache.contains(name))return cache.value(name);
     QIcon icon;
     for (int size : {16, 22, 32, 48, 64}) {
         const QPixmap image = KIconLoader::global()->loadIcon(name, KIconLoader::Desktop, size, 0, {}, nullptr, true);
         if (!image.isNull()) icon.addPixmap(image);
     }
+    cache.insert(name,icon);
     return icon;
 }
 }
