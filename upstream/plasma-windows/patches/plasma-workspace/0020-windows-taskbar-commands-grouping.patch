diff --git a/libtaskmanager/windowswindowactions.h b/libtaskmanager/windowswindowactions.h
new file mode 100644
--- /dev/null
+++ b/libtaskmanager/windowswindowactions.h
@@ -0,0 +1,23 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+#pragma once
+#include <windows.h>
+namespace TaskManager {
+inline bool windowIdentity(HWND window,DWORD expected)
+{
+    DWORD pid=0;return expected && IsWindow(window) && GetWindowThreadProcessId(window,&pid) && pid==expected;
+}
+inline bool windowCommandAllowed(HWND window,DWORD expected,UINT command)
+{
+    if(!windowIdentity(window,expected))return false;
+    const auto style=GetWindowLongPtrW(window,GWL_STYLE);
+    if(command==SC_MINIMIZE && !(style&WS_MINIMIZEBOX))return false;
+    if(command==SC_MAXIMIZE && !(style&WS_MAXIMIZEBOX))return false;
+    if(command==SC_RESTORE && !IsIconic(window) && !IsZoomed(window))return false;
+    const UINT flags=GetMenuState(GetSystemMenu(window,FALSE),command,MF_BYCOMMAND);
+    return (style&WS_SYSMENU) && flags!=UINT(-1) && !(flags&(MF_DISABLED|MF_GRAYED));
+}
+inline bool requestWindowCommand(HWND window,DWORD expected,UINT command)
+{
+    return windowCommandAllowed(window,expected,command) && PostMessageW(window,WM_SYSCOMMAND,command,0);
+}
+}
