diff --git a/libtaskmanager/windowsdesktopapps.h b/libtaskmanager/windowsdesktopapps.h
new file mode 100644
index 0000000..0b03d4a
--- /dev/null
+++ b/libtaskmanager/windowsdesktopapps.h
@@ -0,0 +1,34 @@
+// SPDX-License-Identifier: LGPL-2.1-only OR LGPL-3.0-only OR LicenseRef-KDE-Accepted-LGPL
+#pragma once
+#include <KIconLoader>
+#include <QFileInfo>
+#include <QIcon>
+
+namespace TaskManager {
+struct WindowsDesktopApp { const char *exe; const char *desktop; const char *icon; };
+inline constexpr WindowsDesktopApp windowsDesktopApps[] = {
+    {"konsole.exe", "org.kde.konsole.desktop", "utilities-terminal"},
+    {"dolphin.exe", "org.kde.dolphin.desktop", "system-file-manager"},
+    {"plasma-process-monitor.exe", "org.nixbridge.processmonitor.desktop", "utilities-system-monitor"},
+};
+inline const WindowsDesktopApp *windowsDesktopApp(const QString &value)
+{
+    const QString name = QFileInfo(value).fileName();
+    for (const auto &app : windowsDesktopApps) {
+        if (name.compare(QLatin1String(app.exe), Qt::CaseInsensitive) == 0
+            || name.compare(QLatin1String(app.desktop), Qt::CaseInsensitive) == 0) return &app;
+    }
+    return nullptr;
+}
+inline QIcon windowsRasterThemeIcon(const QString &name)
+{
+    // On Windows a non-null theme engine may still produce no pixmap.
+    // Use KDE's resource-aware loader and keep raster sizes for task delegates.
+    QIcon icon;
+    for (int size : {16, 22, 32, 48, 64}) {
+        const QPixmap image = KIconLoader::global()->loadIcon(name, KIconLoader::Desktop, size, 0, {}, nullptr, true);
+        if (!image.isNull()) icon.addPixmap(image);
+    }
+    return icon;
+}
+}
