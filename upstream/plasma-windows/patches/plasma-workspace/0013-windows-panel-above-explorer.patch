 #ifdef Q_OS_WIN
+void PanelView::enforceWindowsPanelStacking()
+{
+    if (!isVisible()) return;
+    const HWND panel = reinterpret_cast<HWND>(winId());
+    DWORD explorerPid = 0;
+    GetWindowThreadProcessId(GetShellWindow(), &explorerPid);
+    if (!explorerPid) return;
+    // Only re-raise if Explorer's actual taskbar overtook this panel. This
+    // avoids constantly raising over Plasma popups or activating the panel.
+    for (HWND window = GetTopWindow(nullptr); window && window != panel; window = GetWindow(window, GW_HWNDNEXT)) {
+        DWORD pid = 0;
+        GetWindowThreadProcessId(window, &pid);
+        if (pid != explorerPid || !IsWindowVisible(window)) continue;
+        wchar_t name[64]{};
+        GetClassNameW(window, name, 64);
+        if (wcscmp(name, L"Shell_TrayWnd") == 0 || wcscmp(name, L"Shell_SecondaryTrayWnd") == 0) {
+            SetWindowPos(panel, HWND_TOPMOST, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE);
+            return;
+        }
+    }
+}
