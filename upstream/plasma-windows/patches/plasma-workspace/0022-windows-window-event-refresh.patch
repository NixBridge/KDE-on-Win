 #pragma once
 #include <windows.h>
 namespace TaskManager {
+// The foreground may be a modal/tool dialog that has no separate task entry.
+// Prefer a task for the exact window, then walk a bounded owner chain.
+template<typename IsTask>
+inline HWND activationTask(HWND foreground, IsTask isTask)
+{
+    for (int depth = 0; foreground && IsWindow(foreground) && depth < 32; ++depth) {
+        if (isTask(foreground)) return foreground;
+        const HWND owner = GetWindow(foreground, GW_OWNER);
+        if (owner == foreground) break;
+        foreground = owner;
+    }
+    return nullptr;
+}
