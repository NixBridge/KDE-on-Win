# Native diagnostic executables; enabled explicitly for VM packages.
find_package(Qt6 REQUIRED COMPONENTS Widgets)
add_executable(breeze-mapping-probe "${PROJECT_SOURCE_DIR}/probes/breeze-mapping-probe.cpp" "${SOURCE_ROOT}/startmenu/windowsiconmap.cpp")
target_include_directories(breeze-mapping-probe PRIVATE "${SOURCE_ROOT}/startmenu")
target_link_libraries(breeze-mapping-probe PRIVATE Qt6::Gui KF6::IconThemes)
add_executable(context-menu-probe "${PROJECT_SOURCE_DIR}/probes/context-menu-probe.cpp")
target_link_libraries(context-menu-probe PRIVATE Qt6::Widgets Qt6::Quick)
install(TARGETS breeze-mapping-probe context-menu-probe RUNTIME DESTINATION bin)
add_executable(desktop-launch-probe "${PROJECT_SOURCE_DIR}/probes/desktop-launch-probe.cpp")
target_link_libraries(desktop-launch-probe PRIVATE Qt6::Widgets Qt6::Qml ole32)
install(TARGETS desktop-launch-probe RUNTIME DESTINATION bin)
add_executable(native-file-icon-probe "${PROJECT_SOURCE_DIR}/probes/native-file-icon-probe.cpp" "${SOURCE_ROOT}/startmenu/startmenuimageprovider.cpp" "${SOURCE_ROOT}/startmenu/windowsiconmap.cpp" "${SOURCE_ROOT}/startmenu/windowsshortcut.cpp")
target_include_directories(native-file-icon-probe PRIVATE "${SOURCE_ROOT}/startmenu")
target_link_libraries(native-file-icon-probe PRIVATE Qt6::Quick KF6::IconThemes shell32 ole32 user32 gdi32)
install(TARGETS native-file-icon-probe RUNTIME DESTINATION bin)
add_executable(icon-probe "${PROJECT_SOURCE_DIR}/probes/icon-probe.cpp")
target_link_libraries(icon-probe PRIVATE Qt6::Gui KF6::IconThemes)
install(TARGETS icon-probe RUNTIME DESTINATION bin)
find_package(KF6KIO REQUIRED)
add_executable(desktop-protocol-probe "${PROJECT_SOURCE_DIR}/probes/desktop-protocol-probe.cpp")
target_link_libraries(desktop-protocol-probe PRIVATE KF6::KIOCore)
install(TARGETS desktop-protocol-probe RUNTIME DESTINATION bin)
add_executable(qml-import-probe "${PROJECT_SOURCE_DIR}/probes/qml-import-probe.cpp")
target_link_libraries(qml-import-probe PRIVATE Qt6::Gui Qt6::Qml)
install(TARGETS qml-import-probe RUNTIME DESTINATION bin)
find_package(KF6WindowSystem 6.26 REQUIRED)
add_executable(kwindowsystem-probe "${SOURCE_ROOT}/../probe/kwindowsystem-probe/main.cpp")
target_compile_options(kwindowsystem-probe PRIVATE /utf-8)
target_link_libraries(kwindowsystem-probe PRIVATE Qt6::Gui KF6::WindowSystem user32)
install(TARGETS kwindowsystem-probe RUNTIME DESTINATION bin)
