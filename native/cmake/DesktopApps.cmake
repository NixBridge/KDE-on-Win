find_package(Qt6 REQUIRED COMPONENTS Widgets)
find_package(KF6IconThemes REQUIRED)
find_package(KF6ColorScheme REQUIRED)
find_package(KF6Config REQUIRED)
foreach(app IN ITEMS text-editor system-settings)
    add_executable(plasma-${app} WIN32 "${PROJECT_SOURCE_DIR}/apps/${app}.cpp")
    target_compile_options(plasma-${app} PRIVATE /utf-8)
    target_link_libraries(plasma-${app} PRIVATE Qt6::Widgets KF6::IconThemes)
    install(TARGETS plasma-${app} RUNTIME DESTINATION bin)
endforeach()
add_executable(plasma-window-decorations WIN32 "${PROJECT_SOURCE_DIR}/apps/window-decorations.cpp")
target_compile_definitions(plasma-window-decorations PRIVATE NOMINMAX UNICODE _UNICODE _WIN32_WINNT=0x0A00)
target_link_libraries(plasma-window-decorations PRIVATE Qt6::Widgets Qt6::DBus KF6::IconThemes user32 advapi32 dwmapi)
install(TARGETS plasma-window-decorations RUNTIME DESTINATION bin)
add_executable(plasma-notification-bridge WIN32 "${PROJECT_SOURCE_DIR}/notifications/windowsnotificationbridge.cpp")
target_compile_definitions(plasma-notification-bridge PRIVATE NOMINMAX UNICODE _UNICODE)
target_link_libraries(plasma-notification-bridge PRIVATE notificationrelay Qt6::Widgets KF6::IconThemes windowsapp)
install(TARGETS plasma-notification-bridge RUNTIME DESTINATION bin)
add_library(plasmawindowsstyle MODULE "${PROJECT_SOURCE_DIR}/style/plasmawindowsstyle.cpp")
target_compile_definitions(plasmawindowsstyle PRIVATE NOMINMAX UNICODE _UNICODE)
target_link_libraries(plasmawindowsstyle PRIVATE Qt6::Widgets KF6::IconThemes KF6::ColorScheme KF6::ConfigCore user32)
install(TARGETS plasmawindowsstyle RUNTIME DESTINATION plugins/styles LIBRARY DESTINATION plugins/styles)
add_executable(plasma-kde-launcher WIN32 "${PROJECT_SOURCE_DIR}/apps/kde-launcher.cpp")
target_link_libraries(plasma-kde-launcher PRIVATE Qt6::Gui)
install(TARGETS plasma-kde-launcher RUNTIME DESTINATION bin)
add_executable(plasma-process-monitor WIN32 "${PROJECT_SOURCE_DIR}/apps/process-monitor.cpp" "${SOURCE_ROOT}/startmenu/windowsiconmap.cpp")
target_compile_definitions(plasma-process-monitor PRIVATE NOMINMAX UNICODE _UNICODE _WIN32_WINNT=0x0A00)
target_compile_options(plasma-process-monitor PRIVATE /utf-8)
target_include_directories(plasma-process-monitor PRIVATE "${SOURCE_ROOT}/startmenu")
target_link_libraries(plasma-process-monitor PRIVATE Qt6::Widgets KF6::IconThemes psapi)
install(TARGETS plasma-process-monitor RUNTIME DESTINATION bin)
install(DIRECTORY "${PROJECT_SOURCE_DIR}/apps/launchers/" DESTINATION bin/data/applications FILES_MATCHING PATTERN "*.desktop")
